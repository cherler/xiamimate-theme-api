# Phase 3 shadow validation defaults
XIAMIMATE_BASELINE_ROOT=/absolute/path/to/xiamimate
XIAMIMATE_PYTHON_BIN=/absolute/path/to/python

PG_HOST=localhost
PG_PORT=5432
PG_DB=xiamimate
PG_USER=xiamimate
PG_PASSWORD=xiamimate

XIAMIMATE_THEME_API_KEY=
THEME_API_HOST=0.0.0.0
THEME_API_PORT=18100
API_BASE_URL=http://127.0.0.1:18100

# Optional query normalizer LLM
THEME_QUERY_NORMALIZER_ENABLED=false
THEME_QUERY_NORMALIZER_PROFILE=
THEME_QUERY_NORMALIZER_BASE_URL=
THEME_QUERY_NORMALIZER_MODEL=
THEME_QUERY_NORMALIZER_API_KEY=
THEME_QUERY_NORMALIZER_TIMEOUT_SECONDS=60
THEME_QUERY_NORMALIZER_SKIP_SIMPLE_ENGLISH=true
THEME_QUERY_NORMALIZER_FORCE_LLM=false
